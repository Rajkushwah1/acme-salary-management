# Environment and Secrets
.env
.env.*
!.env.example
*.local
master.key
config/master.key
config/credentials/*.key

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Ruby and Bundler
*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/
/vendor/bundle/
.bundle/

# Ignore database credentials and sqlite databases
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-shm
/db/*.sqlite3-wal

# Logs
/log/*
!/log/.keep

# Storage and uploads
/storage/*
!/storage/.keep
/public/assets

# Node and Vite
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# Ignore key files for decrypting credentials and more.
/config/*.key

/cache/
/build_info/
/doc/

